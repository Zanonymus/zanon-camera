import { Palette } from "std-widgets.slint";

// Material 3 colour roles. Defaults follow the OS light/dark scheme; Android overwrites them with Material You colours.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    in-out property <color> primary: dark ? #d0bcff : #6750a4;
    in-out property <color> on-primary: dark ? #381e72 : #ffffff;
    in-out property <color> primary-container: dark ? #4f378b : #eaddff;
    in-out property <color> on-primary-container: dark ? #eaddff : #21005d;
    in-out property <color> secondary-container: dark ? #4a4458 : #e8def8;
    in-out property <color> on-secondary-container: dark ? #e8def8 : #1d192b;
    in-out property <color> surface: dark ? #141218 : #fef7ff;
    in-out property <color> surface-container: dark ? #211f26 : #f3edf7;
    in-out property <color> on-surface: dark ? #e6e0e9 : #1d1b20;
}

component TonalIconButton inherits Rectangle {
    in property <image> icon: @image-url("icons/flip-camera.svg");
    callback clicked();
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background: touch.pressed ? Theme.on-secondary-container.with-alpha(0.3) : Theme.secondary-container.with-alpha(0.85);
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        colorize: Theme.on-secondary-container;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Shutter inherits Rectangle {
    callback clicked();
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 4px;
    border-color: #ffffff;
    background: transparent;
    animate border-width { duration: 120ms; easing: ease-out; }
    Rectangle {
        width: touch.pressed ? 56px : 66px;
        height: self.width;
        border-radius: self.width / 2;
        background: touch.pressed ? Theme.primary-container : #ffffff;
        animate width { duration: 120ms; easing: ease-out; }
        animate background { duration: 120ms; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    in property <image> preview;
    in property <string> status;
    in property <string> qr-text;
    in property <string> toast;
    in property <image> last-photo;
    in property <bool> flash-available;
    in property <float> max-zoom: 1;
    in-out property <float> zoom: 1;
    in-out property <int> flash-mode: 0;
    property <float> pinch-start: 1;
    callback set-zoom(float);
    callback set-flash(int);
    callback open-gallery();
    callback shutter();
    callback flip();
    callback dismiss-qr();
    title: "Camera";
    preferred-width: 420px;
    preferred-height: 800px;
    background: #000000;

    Image {
        source: root.preview;
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }

    ScaleRotateGestureHandler {
        started => { root.pinch-start = root.zoom; }
        updated => { root.set-zoom(max(1, min(root.max-zoom, root.pinch-start * self.scale))); }
    }

    if root.preview.width == 0: Text {
        text: root.status != "" ? root.status : "Starting camera…";
        color: #ffffffcc;
        font-size: 16px;
        horizontal-alignment: center;
        wrap: word-wrap;
        vertical-alignment: center;
        width: parent.width - 64px;
        height: parent.height;
        x: 32px;
        y: 0px;
    }

    // Bottom controls
    Rectangle {
        y: parent.height - self.height;
        height: 168px;
        width: parent.width;
        background: @linear-gradient(180deg, #00000000 0%, #000000aa 100%);

        Shutter {
            x: (parent.width - self.width) / 2;
            y: 40px;
            clicked => { root.shutter(); }
        }
        TonalIconButton {
            x: parent.width - self.width - 40px;
            y: 54px;
            clicked => { root.flip(); }
        }
        // Last photo: opens in the gallery app
        Rectangle {
            x: 40px;
            y: 54px;
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: Theme.secondary-container.with-alpha(0.6);
            clip: true;
            Image {
                source: root.last-photo;
                image-fit: cover;
                width: parent.width;
                height: parent.height;
            }
            TouchArea { clicked => { root.open-gallery(); } }
        }
        // Zoom presets
        HorizontalLayout {
            y: -8px;
            height: 36px;
            alignment: center;
            spacing: 8px;
            visible: root.max-zoom > 1;
            for z in [1.0, 2.0, 5.0]: Rectangle {
                visible: z <= root.max-zoom;
                width: z <= root.max-zoom ? 52px : 0px;
                height: 36px;
                border-radius: 18px;
                background: abs(root.zoom - z) < 0.05 ? Theme.primary-container : #00000066;
                Text {
                    text: z + "×";
                    color: abs(root.zoom - z) < 0.05 ? Theme.on-primary-container : #ffffff;
                    font-size: 14px;
                    font-weight: 600;
                }
                TouchArea { clicked => { root.set-zoom(z); } }
            }
        }
    }

    // Top bar: flash mode
    if root.flash-available: TonalIconButton {
        x: 16px;
        y: 24px;
        icon: root.flash-mode == 0 ? @image-url("icons/flash-off.svg") : root.flash-mode == 1 ? @image-url("icons/flash-auto.svg") : root.flash-mode == 2 ? @image-url("icons/flash-on.svg") : @image-url("icons/torch.svg");
        clicked => {
            root.flash-mode = Math.mod(root.flash-mode + 1, 4);
            root.set-flash(root.flash-mode);
        }
    }
    if root.zoom > 1.05: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 32px;
        width: 64px;
        height: 32px;
        border-radius: 16px;
        background: #00000088;
        Text { text: Math.round(root.zoom * 10) / 10 + "×"; color: #ffffff; font-size: 14px; }
    }

    // QR result card (Material tonal surface)
    if root.qr-text != "": Rectangle {
        x: 16px;
        y: 24px;
        width: parent.width - 32px;
        height: card.preferred-height + 24px;
        border-radius: 20px;
        background: Theme.surface-container;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        card := VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text {
                text: "QR code";
                color: Theme.primary;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: root.qr-text;
                color: Theme.on-surface;
                font-size: 16px;
                wrap: word-wrap;
            }
        }
        TouchArea { clicked => { root.dismiss-qr(); } }
    }

    // Saved confirmation
    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 220px;
        width: toast-text.preferred-width + 40px;
        height: 44px;
        border-radius: 22px;
        background: Theme.primary-container;
        toast-text := Text {
            text: root.toast;
            color: Theme.on-primary-container;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
