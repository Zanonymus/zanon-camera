export component MainWindow inherits Window {
    in property <image> preview;
    in property <string> status;
    in property <string> qr-text;
    callback shutter();
    title: "Camera";
    preferred-width: 480px;
    preferred-height: 720px;
    background: #000000;

    VerticalLayout {
        Image {
            source: root.preview;
            image-fit: contain;
            vertical-stretch: 1;
        }
        Text {
            text: root.qr-text != "" ? "QR: " + root.qr-text : root.status;
            color: #ffffff;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 96px;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: touch.pressed ? #cccccc : #ffffff;
                touch := TouchArea { clicked => { root.shutter(); } }
            }
        }
    }
}
